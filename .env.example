# Copy to .env (repo root) and adjust. Never commit .env.

# ---- Backend (FastAPI) ----
APP_ENV=development                 # development | test | production
DATA_DIR=./data                     # uploaded PDFs and retrieval indexes (and JSON records when DATABASE_URL is empty)
JWT_SECRET=                         # REQUIRED in production, >= 32 chars:
                                    #   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=720
FRONTEND_ORIGIN=http://localhost:5173          # comma-separated list allowed
FRONTEND_ORIGIN_REGEX=                         # optional; scope to your team, e.g. https://cte-system-[a-z0-9-]+-<team>\.vercel\.app

# Storage: PostgreSQL when set, otherwise the JSON file store under DATA_DIR/store.
DATABASE_URL=                       # e.g. postgresql://cte:password@localhost:5432/cte
# Workflow state (live per-agent progress): Redis when set, otherwise in-process memory.
REDIS_URL=                          # e.g. redis://localhost:6379/0
RUN_STATE_TTL_SECONDS=86400
STALE_RUN_MINUTES=30                # at startup, queued/running runs older than this are marked interrupted

# LLM is optional: with LLM_PROVIDER=none the system runs fully offline (rule-based extractor).
LLM_PROVIDER=gemini                 # gemini | anthropic | openai | none
LLM_API_KEY=                         # Gemini: free key from https://aistudio.google.com/apikey
LLM_MODEL=                          # default: gemini-flash-latest / claude-opus-5-5 / gpt-4o-mini
LLM_SEMANTIC_EVALUATION=true        # false -> patient data is never sent to the LLM (free-text criteria become UNKNOWN)

EMBEDDINGS_ENABLED=true             # false -> deterministic keyword retriever (tests, low-memory hosts)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Clinical NLP (BioBERT): flags differently worded diagnoses that may match a criterion. Review notes only.
CLINICAL_NLP_ENABLED=false
CLINICAL_NLP_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb
CLINICAL_NLP_THRESHOLD=0.75

# Web search for ambiguous criteria (protocol wording only, never patient data). Free key: https://tavily.com
WEB_SEARCH_PROVIDER=none            # tavily | none
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_QUERIES=3

MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
AUTH_RATE_LIMIT_PER_MINUTE=10       # login/register attempts per IP (and per email); 0 disables
STALE_DAYS=90
LOG_LEVEL=INFO

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:8000
